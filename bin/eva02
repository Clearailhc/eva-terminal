               side=(255, 215, 0), key=(0, 255, 0), data=(0, 255, 255)),
    "01": dict(unit="EVA-01", tag="UNIT-01", org="NERV", model="TEST TYPE", pilot="SHINJI IKARI",
               child="THIRD CHILD", jp="碇シンジ", quote="I mustn't run away.",
               main=(150, 90, 235), shadow=(70, 40, 125), frame=(150, 90, 235), alt=(155, 227, 74), alt2=(95, 160, 40),
               side=(255, 138, 31), key=(155, 227, 74), data=(205, 180, 255)),
    "02": dict(unit="EVA-02", tag="UNIT-02", org="NERV", model="PRODUCTION MODEL", pilot="ASUKA LANGLEY SORYU",
               child="SECOND CHILD", jp="惣流・アスカ", quote="Anta baka?",
               main=(230, 32, 40), shadow=(150, 10, 25), frame=(230, 32, 40), alt=(255, 128, 0), alt2=(190, 80, 0),
               side=(255, 190, 40), key=(150, 255, 60), data=(70, 210, 255)),
    "06": dict(unit="MARK.06", tag="MARK.06", org="SEELE", model="SEELE UNIT", pilot="KAWORU NAGISA",
               child="FIFTH CHILD", jp="渚カヲル", quote="Song is good.",
               main=(80, 130, 245), shadow=(30, 50, 120), frame=(80, 130, 245), alt=(232, 236, 245), alt2=(150, 160, 185),
               side=(150, 190, 255), key=(232, 236, 245), data=(130, 220, 255)),
    "08": dict(unit="EVA-08", tag="UNIT-08", org="WILLE", model="WILLE UNIT", pilot="MARI MAKINAMI",
               child="EURO PILOT", jp="真希波・マリ", quote="Hello, puppy-kun!",
               main=(255, 79, 163), shadow=(130, 30, 80), frame=(255, 79, 163), alt=(46, 230, 168), alt2=(25, 150, 110),
               side=(245, 235, 255), key=(46, 230, 168), data=(255, 170, 215)),
}


class T:
    """The active unit: ANSI strings for each palette role plus its words. Set by use_unit()."""


def unit_code(s):
    """'1', '01', 'EVA-01', 'mark.06' → '01' / '06'; None if it names no known unit."""
    d = re.sub(r"\D", "", str(s or ""))
    return d.zfill(2) if d and d.zfill(2) in UNITS else None


def use_unit(code, default="02"):
    T.code = unit_code(code) or default
    u = UNITS[T.code]
    for k, v in u.items():
        setattr(T, k, fg(*v) if k in ROLES else v)
    T.rgb = {k: u[k] for k in ROLES}
    T.rgb["dark"] = tuple(c // 4 for c in u["frame"])   # badge / tmux session background
    T.rgb["deep"] = tuple(c // 9 for c in u["frame"])   # tmux status bar background
    T.bg_main, T.bg_dark = bg(*u["frame"]), bg(*T.rgb["dark"])
    T.hex = lambda role: "#%02x%02x%02x" % T.rgb[role]


use_unit(os.environ.get("EVA_UNIT"))

# ANSI Shadow lettering for the unit / organisation names
