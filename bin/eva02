#!/usr/bin/env python3
"""MAGI remote link — GPU server banner and live monitor (default unit: EVA-02).

  eva02            login banner (avatar + host/GPU snapshot)
  eva02 home [s]   the banner page, live-refreshing in place (q quit, +/- interval)
  eva02 watch [s]  detailed live monitor: per-process rows, power, util history
  eva02 seg MODE   one-line summary for prompt / tmux (MODE = prompt | tmux), cached
  eva02 units      list the available units (themes)
  eva02 template   fill @@role@@ / @@unit@@ placeholders in a config read from stdin

EVA_UNIT=01|02|00|06|08 picks the unit; it only changes looks, never the data shown.
"""
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import time
import unicodedata

HOME = os.path.expanduser("~")
AVATARS = os.environ.get("EVA_AVATARS") or os.path.join(HOME, ".local/share/eva-terminal/units")
CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.join(HOME, ".cache")), "eva02")
SEG_TTL = float(os.environ.get("EVA02_TTL", "10"))
HOT_C = int(os.environ.get("EVA02_HOT", "80"))
IDLE_UTIL, IDLE_MEM_MIB = 5, 1024
DEMO = os.environ.get("EVA02_DEMO") == "1"  # fake 8-GPU data, for screenshots / trying it without a GPU

# ── semantic colours: the same for every unit, so alerts always read the same ─
def fg(r, g, b): return f"\x1b[38;2;{r};{g};{b}m"
def bg(r, g, b): return f"\x1b[48;2;{r};{g};{b}m"
RST, BOLD, DIM, REV = "\x1b[0m", "\x1b[1m", "\x1b[2m", "\x1b[7m"
RED = fg(230, 32, 40)       # critical / overheat
ORG = fg(255, 128, 0)       # high
AMB = fg(255, 190, 40)      # medium
LIME = fg(150, 255, 60)     # ok / standby
WHT = fg(240, 236, 232)
GRY = fg(130, 125, 135)
DGRY = fg(70, 66, 76)

# ── units (themes) ───────────────────────────────────────────────
# Palette roles: main = big lettering, shadow = its box-drawing shadow, frame = borders,
# alt / alt2 = secondary accents and section stripes, side = labels, key = row keys,
# data = highlighted values (users, VRAM bars, tags).
ROLES = ("main", "shadow", "frame", "alt", "alt2", "side", "key", "data")
UNITS = {
    "00": dict(unit="EVA-00", tag="UNIT-00", org="NERV", model="PROTOTYPE", pilot="REI AYANAMI",
