#!/usr/bin/env python3
"""NERV HQ — local terminal banner (default unit: EVA-00), built on the eva02 engine.

  eva00            banner (replaces fastfetch on shell start)
  eva00 home [s]   the same page, live-refreshing in place (q quit, +/- interval)

Switch unit with `eva-unit 01` (saved), or `EVA_UNIT=01 eva00` for a one-off.
"""
import glob
import os
import sys
import time
import importlib.util
from importlib.machinery import SourceFileLoader

# shared engine: the eva02 script installed next to this one
_engine = os.path.join(os.path.dirname(os.path.realpath(__file__)), "eva02")
_spec = importlib.util.spec_from_loader("evacore", SourceFileLoader("evacore", _engine))
core = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(core)
RST, BOLD, bar, heat, heat_rgb, fg, vlen, pad, run, T = (
    core.RST, core.BOLD, core.bar, core.heat, core.heat_rgb, core.fg, core.vlen, core.pad, core.run, core.T)
core.use_unit(core.chosen_unit(), default="00")

# semantic colours (state, not theme) — the 256-colour codes of the original fastfetch look
def c256(n): return f"\x1b[38;5;{n}m"
OK, AMB, ORG, RED = c256(46), c256(220), c256(208), c256(196)
WHT, GRY, DGRY = c256(255), c256(245), c256(239)
if core.LIGHT:  # the 256-colour set is for dark backgrounds; use the engine's contrast-checked ones
    OK, AMB, ORG, RED, WHT, GRY, DGRY = core.LIME, core.AMB, core.ORG, core.RED, core.WHT, core.GRY, core.DGRY

W = 70  # info column width: Rei (42) + 2 + 70 fits a 114-column terminal
KEY = 12  # "│ " + 10-char key, matching the original "│ DESIGNATION" column


# ── sensors ──────────────────────────────────────────────────────
def rd(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def hwmon(name):
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if rd(f"{d}/name") == name:
            return d
    return None


def cpu_model():
    for line in open("/proc/cpuinfo"):
        if line.startswith("model name"):
            return line.split(":", 1)[1].strip().replace("(R)", "").replace("(TM)", "").replace("Intel Core ", "")
    return "CPU"


def cpu_freqs():
    cur = [int(rd(p, 0)) / 1e6 for p in sorted(glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq"))]
    mx = int(rd("/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq", 0)) / 1e6
    return (sum(cur) / len(cur) if cur else 0), max(cur, default=0), mx


def temps():
    """(cpu package °C, nvme °C, fan rpm) — any may be None."""
    pkg = nvme = fan = None
    d = hwmon("coretemp")
    if d:
        for lab in glob.glob(f"{d}/temp*_label"):
            if rd(lab, "").startswith("Package"):
                pkg = int(rd(lab.replace("_label", "_input"), 0)) / 1000
    d = hwmon("nvme")
    if d:
        nvme = int(rd(f"{d}/temp1_input", 0)) / 1000
    for name in ("thinkpad", "dell_smm", "asus", "acpi_fan"):
        d = hwmon(name)
        v = rd(f"{d}/fan1_input") if d else None
        if v and v.isdigit():
            fan = int(v)
            break
    return pkg, nvme, fan


def gpu():
    """Intel iGPU via i915/xe sysfs: (name, act MHz, max MHz) or None."""
    for card in sorted(glob.glob("/sys/class/drm/card[0-9]")):
        dev = f"{card}/device"
        for act, mx in ((f"{dev}/tile0/gt0/freq0/act_freq", f"{dev}/tile0/gt0/freq0/rp0_freq"),
                        (f"{card}/gt_act_freq_mhz", f"{card}/gt_RP0_freq_mhz")):
            a, m = rd(act), rd(mx)
            if a and m:
                drv = os.path.basename(os.path.realpath(f"{dev}/driver"))
                return drv, int(a), int(m)
    return None


def gpu_name():
    out = run(["lspci"], timeout=1)
    for line in out.splitlines():
        if "VGA" in line or "Display" in line:
            name = line.split(":", 2)[-1]
            if "[" in name and "]" in name:
                return name[name.index("[") + 1:name.index("]")]
            return name.strip()[:24]
    return "GPU"


def battery():
    for b in sorted(glob.glob("/sys/class/power_supply/BAT*")):
        cap = rd(f"{b}/capacity")
        if cap is None:
            continue
        st = rd(f"{b}/status", "?")
        pw = int(rd(f"{b}/power_now", 0)) / 1e6
        now, full = int(rd(f"{b}/energy_now", 0)) / 1e6, int(rd(f"{b}/energy_full", 0)) / 1e6
        design = int(rd(f"{b}/energy_full_design", 0)) / 1e6
        left = None
        if pw > 0.5 and st == "Discharging":
            left = now / pw
        elif pw > 0.5 and st == "Charging":
            left = (full - now) / pw
        return dict(cap=int(cap), st=st, pw=pw, left=left, health=full / design * 100 if design else None)
    return None


def power_profile():
    return rd("/sys/firmware/acpi/platform_profile")


def links():
    """[(iface, ipv4)] for interfaces that are up, skipping loopback/docker."""
    out = run(["ip", "-br", "-4", "addr"], timeout=1)
    res = []
    for line in out.splitlines():
        p = line.split()
        if len(p) >= 3 and p[0] != "lo" and not p[0].startswith(("docker", "br-", "veth")):
            res.append((p[0], p[2].split("/")[0]))
    return res


_NET_PREV = None


def net_rate():
    """(down B/s, up B/s) summed over non-loopback interfaces since the last call."""
    global _NET_PREV
    rx = tx = 0
    for line in open("/proc/net/dev").readlines()[2:]:
        name, data = line.split(":", 1)
        if name.strip() == "lo":
            continue
        f = data.split()
        rx, tx = rx + int(f[0]), tx + int(f[8])
    now = time.time()
    prev, _NET_PREV = _NET_PREV, (now, rx, tx)
    if not prev or now <= prev[0]:
        return None
    dt = now - prev[0]
    return (rx - prev[1]) / dt, (tx - prev[2]) / dt


def uname():
    return os.uname()


def login_since():
    """Start of the user's graphical/tty session (who is empty under GNOME on Wayland)."""
    user = os.environ.get("USER", "")
    for line in run(["loginctl", "list-sessions", "--no-legend"], timeout=1).splitlines():
        p = line.split()
        if len(p) >= 3 and p[2] == user and p[3:4] != ["-"]:
            ts = run(["loginctl", "show-session", p[0], "-p", "Timestamp", "--value"], timeout=1).split()
            if len(ts) >= 3:
                return f"{ts[1]} {ts[2]}"
    return ""


# ── widgets ──────────────────────────────────────────────────────
def human(b):
    for unit in ("B", "K", "M", "G"):
        if b < 1024 or unit == "G":
            return f"{b:.0f}{unit}" if unit in ("B", "K") else f"{b:.1f}{unit}"
        b /= 1024


def fmt_h(h):
    return f"{int(h)}h{int(h * 60) % 60:02d}m"


def section(stripe_a, stripe_b, title, tag):
    s = "".join((stripe_a if i % 2 == 0 else stripe_b) + "▰" for i in range(5))
    return f"{s} {stripe_a}{title}{RST} {s}{RST} {tag}{RST}"


def key(k, color=None):
    return f"{color or T.key}│ {k:<{KEY - 2}}{RST}"


def row(k, text, color=None):
    return f"{key(k, color)} {text}"


def bar_row(k, pct, text, color=None, bar_color=None):
    return f"{key(k, color)} {bar(pct, 10, bar_color)} {heat(pct)}{pct:>3.0f}%{RST}  {text}"


def temp_c(t, warn=80, hot=95):
    if t is None:
        return ""
    c = RED + BOLD if t >= hot else ORG if t >= warn else GRY
    return f"{c}{t:.0f}°C{RST}"


def core_bars(vals):
    """One vertical eighth-block per core, coloured by load."""
    ticks = "▁▂▃▄▅▆▇█"
    return "".join(fg(*heat_rgb(v)) + ticks[min(7, int(v / 100 * 7.999))] + " " for v in vals) + RST


def box(lines, color=None, width=W):
    color = color or T.frame
    inner = width - 2
    out = [f"{color}╔{'═' * inner}╗{RST}"]
    out += [f"{color}║{RST}{pad(' ' + l + RST, inner)}{color}║{RST}" for l in lines]
    out.append(f"{color}╚{'═' * inner}╝{RST}")
    return out


def nerve_bar(width=W):
    inner = width - 2
    a, a2 = T.alt, T.alt2
    title = f"{T.main}00101{a} ●{a2}────{a}● NERVE CONNECTION INTERFACE ●{a2}────{a}● {T.main}00102"
    mid = pad(" " + title, inner)
    return [f"{a}╔══●{a2}{'━' * (inner - 6)}{a}●══╗{RST}",
            f"{a}║{RST}{mid}{RST}{a}║{RST}",
            f"{a}╚══●{a2}{'━' * (inner - 6)}{a}●══╝{RST}"]


def settled_cols():
    """Terminal width, waiting out the 80x24 a terminal reports before it sizes the new pty."""
    if os.environ.get("COLUMNS", "").isdigit():
        return int(os.environ["COLUMNS"])

    def size():
        try:
            return os.get_terminal_size(sys.stdout.fileno())
        except OSError:
            return os.terminal_size((160, 40))
    sz = size()
    if tuple(sz) == (80, 24):
        end = time.time() + 0.5
        while time.time() < end and tuple(sz) == (80, 24):
            time.sleep(0.03)
            sz = size()
    return sz.columns


# ── page ─────────────────────────────────────────────────────────
def page(interval=None, cols=None):
    core.cpu_prime()
    pkg, nvme, fan = temps()
    g = gpu()
    bat = battery()
    net = net_rate()
    m = core.meminfo()
    du, dt = core.disk("/")
    if interval is None:
        time.sleep(0.15)  # give the CPU sampler a window on a one-shot banner
    cpu, cores = core.cpu_usage()
    favg, fmax, fcap = cpu_freqs()
    ncpu = os.cpu_count() or 1
    warn = []

    side = [f"{T.side}{T.unit} SYSTEM", f"{T.side}MAGI INTERFACE", "", f"{T.alt}CLASSIFIED", f"{T.alt}ACCESS ONLY", ""]
    R = box([f"{T.main}{n}  {s}" for n, s in zip(core.big(T.org), side)])
    R += nerve_bar()

    R.append(section(T.alt, T.alt2, "BORDER LINE", f"{T.main}[{T.side}SYSTEM CONFIG{T.main}]"))
    R.append(row("OS", f"{WHT}{core.os_name()} · {uname().machine}{RST}"))
    R.append(row("KERNEL", f"{WHT}{uname().release:<24}{RST}{T.key}UPTIME{RST} {WHT}{core.uptime()}{RST}"))

    R.append(section(T.alt, T.alt2, "ABSOLUTE", f"{T.frame}[{T.side}{T.child}{T.frame}]{RST} {T.data}{T.pilot}"))
    since = login_since()
    R.append(row("DESIGNATION", f"{WHT}{os.environ.get('USER', '')}{RST}" + (f"{GRY}, since {since}{RST}" if since else "")))
    lk = links()
    # live: primary link + throughput; banner: up to two links (e.g. wifi + wireguard)
    shown = lk[:1] if net else lk[:2]
    lk_s = f"{GRY} · {RST}".join(f"{WHT}{ip}{RST} {GRY}{i}{RST}" for i, ip in shown) or f"{RED}OFFLINE{RST}"
    if net:
        lk_s += f"  {T.key}↓{WHT}{human(net[0])}/s {T.alt}↑{WHT}{human(net[1])}/s{RST}"
    R.append(row("NEURAL-LINK", lk_s))

    R.append(section(T.frame, T.alt, "DANGER", f"{T.frame}[{T.side}{T.tag}{T.frame}]{RST} {T.data}CORE STATUS"))
    R.append(bar_row("CPU-CORE", cpu, f"{WHT}{cpu_model()}{RST} {GRY}· {favg:.1f}/{fcap:.1f}GHz{RST}", T.side))
    therm = "  ".join(x for x in (f"{GRY}PKG{RST} {temp_c(pkg)}" if pkg is not None else "",
                                  f"{GRY}FAN{RST} {WHT}{fan}rpm{RST}" if fan is not None else "") if x)
    R.append(row("SYNC-RATE", f"{core_bars(cores)} {therm}", T.side))
    if g:
        drv, act, mx = g
        R.append(bar_row("GPU-CORE", act / mx * 100 if mx else 0,
                         f"{WHT}{gpu_name()}{RST} {GRY}· {act / 1000:.2f}/{mx / 1000:.2f}GHz · {drv}{RST}", T.side, T.data))
    if pkg is not None and pkg >= 95:
        warn.append("CORE TEMPERATURE CRITICAL")

    R.append(section(T.frame, T.alt, "WARNING", f"{T.side}[{T.data}LCL{T.side}] [{T.data}A.T. FIELD{T.side}]"))
    memp = m["used"] / m["total"] * 100
    swap = f" · swap {m['swapu']:.1f}/{m['swapt']:.0f}G" if m["swapt"] else ""
    R.append(bar_row("LCL-LEVEL", memp, f"{WHT}{m['used']:.1f}{GRY}/{m['total']:.1f}G{RST}  {GRY}cache {m['cache']:.1f}G{swap}{RST}", T.alt))
    dp = du / dt * 100 if dt else 0
    R.append(bar_row("ENTRY-PLUG", dp, f"{WHT}{du:.0f}{GRY}/{dt / 1024:.2f}T{RST}  {GRY}/ · nvme{RST} {temp_c(nvme, 60, 70)}", T.alt))
    if bat:
        st = {"Charging": f"{OK}⚡ charging", "Discharging": f"{AMB}on battery", "Full": f"{OK}full",
              "Not charging": f"{GRY}plugged"}.get(bat["st"], f"{GRY}{bat['st']}")
        extra = f" {GRY}· {WHT}{bat['pw']:.1f}W{RST}" if bat["pw"] > 0.5 else ""
        if bat["left"]:
            extra += f" {GRY}· {WHT}{fmt_h(bat['left'])}{RST}"
        prof = power_profile()
        extra += f" {GRY}· {prof}{RST}" if prof else ""
        R.append(bar_row("A.T.FIELD", bat["cap"], f"{st}{RST}{extra}", T.alt, heat(100 - bat["cap"])))
        if bat["cap"] <= 15 and bat["st"] == "Discharging":
            warn.append("A.T. FIELD COLLAPSING")
    if memp >= 90:
        warn.append("LCL PRESSURE CRITICAL")
    if dp >= 90:
        warn.append("ENTRY PLUG NEARLY FULL")

    if warn:
        status = f"{RED}{BOLD}[PATTERN BLUE] {ORG}MAGI: {RED}ALERT {ORG}· {RED}{' · '.join(warn)}"
    else:
        status = f"{T.key}[SYSTEMS NOMINAL] {T.alt}MAGI: {T.key}ONLINE  {T.alt}STATUS: {T.key}OK"
    R += box([status])
    if interval is None:
        R.append(f"{'':6}{T.key}PILOT {T.pilot} - READY FOR DEPLOYMENT{RST}   {GRY}live:{RST} {T.data}eva{RST}")
        R.append(f"{'':8}{T.alt}{T.jp}  ({T.quote}){RST}")
    else:
        R.append(f"{'':6}{OK}●{RST} {WHT}{time.strftime('%H:%M:%S')}{RST}"
                 f" {GRY}every {interval:g}s · +/- interval · q quit{RST}")

    # largest avatar that fits beside the info column; none if the terminal is too narrow
    cols = cols or settled_cols()
    return core.beside(core.avatar_lines(cols - 2 - max(W, max(vlen(r) for r in R))), R)


# ── demo data (EVA00_DEMO=1): fixed fake sensors, for screenshots ─
if os.environ.get("EVA00_DEMO") == "1":
    import math
    _cores = [62, 18, 9, 71, 12, 4, 33, 88, 7, 15, 3, 21, 46, 9, 2, 11]
    core.cpu_usage = lambda: (sum(_cores) / len(_cores), [c + 4 * math.sin(time.time() + i) % 5 for i, c in enumerate(_cores)])
    core.meminfo = lambda: dict(used=11.8, total=31.2, cache=9.6, swapu=0.0, swapt=8.0)
    core.disk = lambda path: (412.0, 1907.0)
    core.uptime = lambda: "3 hours, 7 mins"
    core.os_name = lambda: "Ubuntu 26.04 LTS"
    uname = lambda: os.uname_result(("Linux", "magi", "7.0.0-generic", "#1", "x86_64"))
    cpu_model = lambda: "Core Ultra 7 155H"
    cpu_freqs = lambda: (2.4, 4.6, 4.8)
    temps = lambda: (63.0, 38.0, 2600)
    gpu = lambda: ("xe", 1350, 2250)
    gpu_name = lambda: "Arc Graphics"
    battery = lambda: dict(cap=76, st="Discharging", pw=9.4, left=5.3, health=97.0)
    power_profile = lambda: "balanced"
    links = lambda: [("wlan0", "192.168.1.20"), ("wg0", "10.8.0.2")]
    login_since = lambda: "2026-10-20 08:30:00"
    _net = net_rate
    net_rate = lambda: (1.8e6, 2.4e5) if _net() is not None else None


def main():
    a = sys.argv[1:]
    if not a or a[0] == "banner":
        sys.stdout.write("\n".join(page()) + RST + "\n")
    elif a[0] == "home":
        frame = lambda iv, cols: page(iv, cols)
        core.live(float(a[1]) if len(a) > 1 else 1.0, frame, views={})
    else:
        print(__doc__)


if __name__ == "__main__":
    main()
